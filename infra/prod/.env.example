# Production stack configuration. deploy.sh generates a real .env with random
# passwords on first run — you normally never create this by hand.
# The .env file lives next to docker-compose.prod.yml and is git-ignored.

# Public hostname for the demo. Empty = plain HTTP on :80 (IP-only VM / CI).
# Set to a DNS name pointing at the VM to enable automatic HTTPS.
DEMO_DOMAIN=

# Internal read-write credentials (collector, eval-runner, migrations).
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Read-only credentials the public dashboard connects with.
POSTGRES_RO_PASSWORD=change-me
CLICKHOUSE_RO_PASSWORD=change-me

# Optional: LLM-judge API key for the eval runner (server-side only; never
# reaches the dashboard or the browser). Unset = judge evals are skipped.
#OPENAI_API_KEY=

# Optional: run prebuilt images instead of building on the VM, e.g. from CI:
#TRACEBLOOM_IMAGE_PREFIX=ghcr.io/<owner>/tracebloom
#TRACEBLOOM_IMAGE_TAG=latest

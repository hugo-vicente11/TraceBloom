{
  "name": "@tracebloom/eval-runner",
  "version": "0.1.0",
  "private": true,
  "description": "TraceBloom evaluation runner: an out-of-band worker that scores captured spans and detects regressions.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tracebloom-eval": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.22.0",
    "@tracebloom/db": "workspace:*",
    "@tracebloom/eval": "workspace:*",
    "@tracebloom/sdk": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
